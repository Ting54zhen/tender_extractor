# Python 缓存与字节码
__pycache__/
*.py[cod]
*$py.class

# 打包与安装产物
build/
dist/
*.egg-info/
.eggs/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# 本地配置与密钥
.env
.env.*
settings.local.json

# 编辑器与系统文件
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 本地数据：真实采购样本、抽取输出、投标文件（含真实单位信息，勿提交）
data/

# 参赛材料（含个人信息，勿提交）
参赛材料/

# 临时文件
*.tmp
*.log

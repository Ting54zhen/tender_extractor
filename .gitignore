# Python 缓存与字节码
__pycache__/
*.py[cod]
*$py.class

# 打包与安装产物
build/
dist/
*.spec
*.egg-info/
.eggs/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# 本地配置与密钥
.env
.env.*
settings.local.json

# 本地 Agent 授权约定（仅本机，禁止提交 / 推送）
AGENTS.local.md

# 编辑器与系统文件
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 本地数据：真实采购样本、抽取输出、投标文件（含真实单位信息，勿提交）
data/

# 参赛材料（含个人信息，勿提交）
参赛材料/

# 临时文件
*.tmp
*.log

# npm 本地依赖与开发缓存；package-lock.json 必须提交以固定依赖树。
node_modules/
.vite/

# 前端构建产物随仓库与 exe 本地分发，单独放行（上面 dist/ 会连带忽略前端产物）。
!frontend/dist/
!frontend/dist/**
